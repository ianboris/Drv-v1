{
  "name": "deriv-digit-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:all-models && tsc -b && vite build",
    "preview": "vite preview",
    "test:api": "node --test tests/*.test.mjs",
    "research": "node worker/research-worker.mjs",
    "test:research": "node --test tests/research-market-data.test.mjs",
    "test:strategy-lab": "node --test tests/strategy-lab.test.mjs",
    "strategy:lab": "node scripts/lotus-strategy-lab.mjs",
    "capture:proposals": "node scripts/capture-deriv-proposals.mjs",
    "test:advanced-model": "node --test tests/advanced-model.test.mjs",
    "test:all-models": "npm run test:strategy-lab && npm run test:advanced-model && npm run test:research-batches",
    "test:research-batches": "node --test tests/research-batch-store.test.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@neondatabase/serverless": "^1.0.2"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "5.4.14"
  },
  "engines": {
    "node": "22.x"
  }
}
